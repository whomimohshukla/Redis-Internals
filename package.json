{
  "name": "redis-caching-interview-lab",
  "version": "1.0.0",
  "description": "Learning-only lab: smallest runnable examples for Redis, caching, and backend/system-design interview prep.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "ts-node-dev --respawn --transpile-only src/server.ts",
    "ex": "ts-node --transpile-only",
    "typecheck": "tsc --noEmit",
    "db:setup": "psql \"$DATABASE_URL\" -f scripts/setup-db.sql",
    "redis:reset": "bash scripts/reset-redis.sh",
    "basics:strings": "ts-node --transpile-only src/basics/strings.ts",
    "basics:hashes": "ts-node --transpile-only src/basics/hashes.ts",
    "basics:lists": "ts-node --transpile-only src/basics/lists.ts",
    "basics:sets": "ts-node --transpile-only src/basics/sets.ts",
    "basics:sorted-sets": "ts-node --transpile-only src/basics/sortedSets.ts",
    "cache:aside": "ts-node --transpile-only src/caching/cache-aside.ts",
    "cache:ttl": "ts-node --transpile-only src/caching/ttl.ts",
    "cache:invalidation": "ts-node --transpile-only src/caching/invalidation.ts",
    "cache:write-through": "ts-node --transpile-only src/caching/write-through.ts",
    "cache:write-around": "ts-node --transpile-only src/caching/write-around.ts",
    "cache:negative": "ts-node --transpile-only src/caching/negative-cache.ts",
    "pattern:stampede": "ts-node --transpile-only src/patterns/cache-stampede.ts",
    "pattern:penetration": "ts-node --transpile-only src/patterns/cache-penetration.ts",
    "pattern:avalanche": "ts-node --transpile-only src/patterns/cache-avalanche.ts",
    "pattern:hot-key": "ts-node --transpile-only src/patterns/hot-key.ts",
    "pattern:warming": "ts-node --transpile-only src/patterns/cache-warming.ts",
    "atomic:counter": "ts-node --transpile-only src/atomic/counter.ts",
    "atomic:operations": "ts-node --transpile-only src/atomic/atomic-operations.ts",
    "atomic:idempotency": "ts-node --transpile-only src/atomic/idempotency.ts",
    "ratelimit:fixed": "ts-node --transpile-only src/rate-limiting/fixed-window.ts",
    "ratelimit:sliding": "ts-node --transpile-only src/rate-limiting/sliding-window.ts",
    "ratelimit:token": "ts-node --transpile-only src/rate-limiting/token-bucket.ts",
    "lock:distributed": "ts-node --transpile-only src/locks/distributed-lock.ts",
    "lock:safe-release": "ts-node --transpile-only src/locks/safe-lock-release.ts",
    "stream:producer": "ts-node --transpile-only src/streams/producer.ts",
    "stream:consumer": "ts-node --transpile-only src/streams/consumer.ts",
    "stream:group": "ts-node --transpile-only src/streams/consumer-group.ts",
    "stream:ack": "ts-node --transpile-only src/streams/acknowledgements.ts",
    "stream:pending": "ts-node --transpile-only src/streams/pending-messages.ts",
    "stream:retry": "ts-node --transpile-only src/streams/retry.ts",
    "stream:idempotent": "ts-node --transpile-only src/streams/idempotent-consumer.ts",
    "stream:taurgo": "ts-node --transpile-only src/streams/taurgo-survey.ts",
    "pubsub": "ts-node --transpile-only src/pubsub/pubsub.ts",
    "perf:pipeline": "ts-node --transpile-only src/performance/pipelining.ts",
    "perf:batching": "ts-node --transpile-only src/performance/batching.ts",
    "perf:connections": "ts-node --transpile-only src/performance/connection-reuse.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
